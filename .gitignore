.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store
inst/doc
reports/
Rplots.pdf
inst/examples/output
inst/examples/generated
inst/examples/params_log.txt
# tools/render_vignettes.R writes the PDFs, the .md files and their
# _files/ figures in doc/. Those are deliberately tracked, so GitHub can
# show them. The throwaway HTML/R/Rmd copies devtools::build_vignettes()
# also drops in doc/ are not. Scoped to these extensions, not a blanket
# doc/ ignore, so a new tracked file still shows up as untracked.
doc/*.html
doc/*.R
doc/*.Rmd
Meta/
# reference material: the internal originals stay untracked; only the
# anonymised plot snippets and the (already published) reference PNGs are
# committed. reference_code.txt remain ignored.
references/*
!references/README.md
!references/plots/
!references/code/
references/code/*
!references/code/reference_plot_snippets.R
ggcpb.Rproj

# scratch: stress-test scripts and their output, kept out of git and
# out of the built package (see .Rbuildignore)
/temp/

# testthat writes failing tests here during a run
/tests/testthat/_problems/

# the rendered vignette HTML is made on the fly (and printed to the PDFs in
# doc/ by tools/render_vignettes.R); only the .Rmd source is tracked
vignettes/*.html
