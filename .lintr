linters: linters_with_defaults(
    line_length_linter = line_length_linter(80L),
    object_name_linter = object_name_linter(
      styles = c("snake_case", "symbols"),
      regexes = c(ggplot2_dotted_argument = "^[a-z]+[.][a-z]+$")
    ),
    object_usage_linter = NULL
  )
exclusions: list(
    "inst/examples/smoke_test_plots.R",
    "inst/examples/legend_stability_test.R"
  )
